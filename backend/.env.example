# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here

# Plain API key (not a service account), restricted to the Cloud Translation
# API and Cloud Text-to-Speech API. Create it under APIs & Services > Credentials.
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Only needed for production/cloud deployment — all three fall back to local
# dev defaults (localhost Mongo, a placeholder session secret, port 8080) if unset.
MONGO_URL=mongodb+srv://user:password@your-cluster.mongodb.net/
SESSION_SECRET=replace_with_a_long_random_string
PORT=8080

# Only needed if the Firebase service-account JSON isn't sitting at the default
# ./service-account.json path — e.g. when it's mounted from a secret volume in
# Cloud Run at a different path (see README's Deployment section).
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
